{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["playwright.v1.config.ts", "v1-e2e/*.ts", "playwright.a11y.config.ts", "e2e/a11y.test.ts"]
}
