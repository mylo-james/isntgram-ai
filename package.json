{
  "name": "isntgram-ai",
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.3",
  "description": "Photo and text sharing social platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:local": "bash scripts/setup-local-env.sh",
    "lint:md": "markdownlint . --ignore-path .markdownlintignore --config .markdownlint.json",
    "lint": "echo 'root lint noop'",
    "lint:all": "pnpm run lint:md && pnpm -r --if-present lint && pnpm run lint:journey && pnpm run lint:v1",
    "lint:web": "pnpm --filter web lint",
    "lint:api": "pnpm --filter api lint",
    "lint:shared-types": "pnpm --filter @isntgram-ai/shared-types lint",
    "type-check": "pnpm exec tsc -p apps/web/tsconfig.json --noEmit && pnpm exec tsc -p apps/api/tsconfig.json --noEmit && pnpm exec tsc -p packages/shared-types/tsconfig.json --noEmit && pnpm exec tsc -p tsconfig.journey.json && pnpm exec tsc -p tsconfig.journey-e2e.json",
    "validate": "pnpm run lint:all && pnpm run type-check && pnpm test -- --watchAll=false && pnpm run build:all",
    "test": "node scripts/jest.cjs",
    "test:integration": "node scripts/jest.cjs --selectProjects api --testPathPatterns integration",
    "test:e2e": "NEXT_PUBLIC_DEMO_ENABLED=true NEXT_PUBLIC_DEMO_EMAIL=demo@isntgram.ai NEXT_PUBLIC_DEMO_PASSWORD=demo pnpm run build:all && playwright test",
    "build": "echo 'root build noop'",
    "build:all": "pnpm -r --if-present build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:shared-types": "pnpm --filter @isntgram-ai/shared-types build",
    "coverage:report": "node scripts/coverage-report.cjs",
    "coverage:changed": "node scripts/coverage-report.cjs --changed",
    "contracts:generate": "node scripts/contracts.cjs generate",
    "contracts:check": "node scripts/contracts.cjs check",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:db": "bash scripts/dev-db.sh",
    "dev:all": "bash scripts/dev-all.sh",
    "usertest": "bash scripts/usertest.sh",
    "prepare": "husky",
    "journey:config": "node apps/api/scripts/journey/config.cjs",
    "journey:preflight": "node apps/api/scripts/journey/preflight.cjs",
    "journey:db": "node apps/api/scripts/journey/db.cjs",
    "journey:migrate": "node apps/api/scripts/journey/migrate.cjs",
    "journey:fixture": "node apps/api/scripts/journey/fixture.cjs",
    "journey:verify": "node apps/api/scripts/journey/verify.cjs",
    "test:journey": "playwright test --config playwright.journey.config.ts",
    "test:journey:guards": "node --test scripts/journey-test-env.test.cjs scripts/contracts.test.cjs apps/api/scripts/journey/*.test.cjs",
    "lint:journey": "eslint --config eslint.journey.config.cjs apps/api/scripts/journey/*.cjs apps/api/test/test-database-target.cjs scripts/jest.cjs scripts/test-env.cjs scripts/journey-test-env.test.cjs scripts/contracts.cjs scripts/contracts.test.cjs",
    "test:journey:fixture": "node apps/api/scripts/journey/fixture.postgres.cjs",
    "v1:config": "node apps/api/scripts/v1/config.cjs",
    "v1:preflight": "node apps/api/scripts/v1/preflight.cjs",
    "v1:db": "node apps/api/scripts/v1/db.cjs",
    "test:v1:guards": "node --test apps/api/scripts/v1/*.test.cjs scripts/coverage-report.test.cjs scripts/coverage-producer.test.cjs",
    "lint:v1": "eslint --config eslint.journey.config.cjs apps/api/scripts/v1/*.cjs apps/api/v1-test/*.cjs scripts/coverage-report.cjs scripts/coverage-report.test.cjs scripts/coverage-producer.test.cjs",
    "v1:migrate": "node apps/api/scripts/v1/migrate.cjs",
    "test:v1:postgres": "node apps/api/scripts/v1/postgres-test.cjs",
    "v1:storage": "node apps/api/scripts/v1/storage.cjs",
    "v1:storage:start": "node apps/api/scripts/v1/storage-start.cjs",
    "test:v1:storage": "node apps/api/scripts/v1/storage-capabilities.cjs prove",
    "v1:storage:bootstrap": "node apps/api/scripts/v1/storage-capabilities.cjs bootstrap",
    "v1:storage:readiness": "node apps/api/scripts/v1/storage-readiness.cjs",
    "v1:storage:retained-sockets": "node apps/api/scripts/v1/storage-retained-sockets.cjs",
    "v1:fixture": "node apps/api/scripts/v1/fixture.cjs apply",
    "v1:fixture:verify": "node apps/api/scripts/v1/fixture.cjs verify",
    "v1:verify": "node apps/api/scripts/v1/verify.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.28.0",
    "@nestjs/cli": "^10.0.0",
    "@playwright/test": "^1.54.2",
    "@swc/core": "^1.7.42",
    "@swc/jest": "^0.2.39",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "axe-core": "^4.11.0",
    "babel-jest": "^30.0.5",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "concurrently": "^9.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.1.5",
    "markdownlint-cli": "^0.37.0",
    "next": "16.2.11",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "sqlite3": "^5.1.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.39.0"
  },
  "lint-staged": {
    "apps/api/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "bash -c 'cd apps/api && pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\" \"ormconfig.ts\" --fix'",
      "bash -c 'cd apps/api && pnpm exec tsc -p . --noEmit'",
      "node scripts/jest.cjs --selectProjects api --testPathIgnorePatterns=integration --findRelatedTests --passWithNoTests --maxWorkers=50%"
    ],
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "bash -c 'cd apps/web && pnpm exec eslint --fix'",
      "bash -c 'cd apps/web && pnpm exec tsc -p . --noEmit'",
      "node scripts/jest.cjs --selectProjects web --findRelatedTests --passWithNoTests --maxWorkers=50%"
    ],
    "packages/shared-types/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "bash -c 'cd packages/shared-types && pnpm exec eslint src/**/*.ts --fix'",
      "bash -c 'cd packages/shared-types && pnpm exec tsc -p . --noEmit'",
      "node scripts/jest.cjs --selectProjects shared-types --findRelatedTests --passWithNoTests --maxWorkers=50%"
    ],
    "scripts/**/*.{js,cjs}": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "next": "16.2.11",
      "eslint-config-next": "16.2.11",
      "@playwright/test": "1.55.1",
      "playwright": "1.55.1",
      "cross-spawn": "^7.0.6",
      "glob@10.4.5": "10.5.0",
      "tar-fs@2.1.3": "2.1.4",
      "execa": "^9.6.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "minimatch@3": "3.1.4",
      "minimatch@5": "5.1.8",
      "minimatch@9": "9.0.7",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash@4": "4.18.1",
      "multer@2": "2.3.0",
      "path-to-regexp@0.1": "0.1.13",
      "tar@6": "7.5.21",
      "socks@2": "2.8.10",
      "picomatch@2": "2.3.2",
      "sharp@<0.35.4": "0.35.4",
      "postcss@8": "8.5.18",
      "nanoid@3": "3.3.18",
      "browserslist@4": "4.28.7"
    }
  },
  "_comment": "Note: CVE-2024-21538 in cross-spawn is a known issue with Jest 30.0.5. The vulnerability is in jest-changed-files/node_modules/execa which is a development-only dependency. This is tracked in .trivyignore and will be resolved when Jest updates jest-changed-files."
}
