# Frontend Environment Variables
# Copy this file to `apps/web/.env.local` for local dev and fill in your values.

# API
# In local dev we run the API on a separate port, so this must be set.
# In production, you can omit it and the browser will use same-origin `/api/*` calls
# (recommended when deploying behind Firebase Hosting or a reverse proxy that routes `/api/*`).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side requests can use a private/internal URL if needed (e.g. http://api:3001 in Docker)
INTERNAL_API_URL=http://localhost:3001

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
# Use a strong random value in production
NEXTAUTH_SECRET=
# Alias used by our NextAuth config; if unset we fall back to NEXTAUTH_SECRET.
AUTH_SECRET=

# Demo Mode (non-sensitive placeholders)
NEXT_PUBLIC_DEMO_EMAIL=demo@isntgram.ai
NEXT_PUBLIC_DEMO_PASSWORD=changeme
DEMO_SESSION_MAX_AGE_SECONDS=3600

# Observability (optional)
# Server-side (Next.js) DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Client-side DSN (public)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Development
NODE_ENV=development
