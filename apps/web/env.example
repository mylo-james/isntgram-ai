# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001
# Server-only HMAC key shared with the API. Required for preview/production.
BFF_PROXY_SECRET=

# Auth.js
AUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
# When deploying behind a reverse proxy, set this to true so Auth.js trusts X-Forwarded-Host.
AUTH_TRUST_HOST=false
# Align Auth.js session lifetime with API JWT expiry (seconds or 7d/24h/60m)
AUTH_SESSION_MAX_AGE=7d
# Optional explicit origin used for CSRF origin checks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Media hosts for next/image (comma-separated host[:port] or full URLs)
NEXT_PUBLIC_MEDIA_HOSTS=localhost:9000,127.0.0.1:9000,cdn.isntgram.ai,picsum.photos
# Max upload size hint for the UI (bytes)
# Note: UI will clamp this to the API contract max (currently 5MB).
NEXT_PUBLIC_MEDIA_MAX_UPLOAD_BYTES=5242880

# Demo
NEXT_PUBLIC_DEMO_ENABLED=true
NEXT_PUBLIC_DEMO_EMAIL=demo@isntgram.ai
NEXT_PUBLIC_DEMO_PASSWORD=demo
# Public demo sessions and visitor uploads expire after 48 hours.
NEXT_PUBLIC_DEMO_TTL_HOURS=48
