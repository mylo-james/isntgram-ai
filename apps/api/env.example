# Backend Environment Variables
# Copy this file to `apps/api/.env` for local dev and fill in your values.

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
# - Use `DB_SSL=false` for local Postgres
# - Use `DB_SSL=true` for most managed Postgres providers
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/isntgram
DB_SSL=false

# Auth
# JWT_SECRET must be set in all environments except tests.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
# In production, `CORS_ORIGIN` is required and should be the web origin (e.g. https://isntgram.mjames.dev)
CORS_ORIGIN=http://localhost:3000

# Throttling
# Applies to endpoints guarded by `ThrottlerGuard` (currently auth endpoints)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Demo user (non-sensitive placeholders)
DEMO_EMAIL=demo@isntgram.ai
DEMO_USERNAME=demo
DEMO_FULL_NAME=Demo User
DEMO_PASSWORD=changeme
# Demo mode controls
# Demo users are blocked from write endpoints; set to `true` to allow AI caption suggestions for demo sessions.
DEMO_ALLOW_AI=false

# AI (optional)
# Enables `POST /api/ai/captions` (caption suggestions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Observability (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Optional / advanced
# Set to `true` to boot the API without database-backed feature modules (useful for infra checks)
SKIP_DB=false

# Logging
# In production, HTTP request logging is enabled by default.
# Set to `true` to enable it in non-production environments.
LOG_REQUESTS=false
