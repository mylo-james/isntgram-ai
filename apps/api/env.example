# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/isntgram
# Direct, non-pooled URL used only by migrations and maintenance jobs.
DATABASE_DIRECT_URL=
DEPLOYMENT_ENV=development
# Database TLS (recommended for managed Postgres)
# - Defaults: enabled in production, disabled otherwise
# - For local Postgres (docker-compose): keep disabled
DATABASE_SSL=false
# Verify server certificate when TLS is enabled (recommended)
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM string for custom CA bundles (managed DBs may provide one)
DATABASE_SSL_CA=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Demo user (optional)
DEMO_ENABLED=true
# Demo accounts are auto-deleted after this many hours (default: 48)
DEMO_TTL_HOURS=48

# Media storage (S3-compatible)
S3_BUCKET=isntgram-media
# Production uses distinct private pending and public validated buckets. The
# single S3_BUCKET value remains a local compatibility default only.
S3_PENDING_BUCKET=
S3_PUBLISHED_BUCKET=
S3_BACKUP_BUCKET=
# Base64-encoded 32 byte key, available only to the backup job.
BACKUP_ENCRYPTION_KEY_BASE64=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/isntgram-media
# Comma-separated allowlist of media hosts accepted in post payloads
# (The host from S3_PUBLIC_BASE_URL is automatically allowed.)
MEDIA_ALLOWED_HOSTS=cdn.isntgram.ai,localhost:9000,127.0.0.1:9000,picsum.photos
# Note: the public API contract caps uploads at 5MB. This value may further restrict uploads,
# but increasing beyond 5MB requires a code + contract change.
MEDIA_MAX_UPLOAD_BYTES=5242880

# Logging
REQUEST_LOGGING=true
METRICS_ENABLED=true

# Rate limiting
THROTTLER_TTL=60000
THROTTLER_LIMIT=10

# Public deployment admission. Omit these in normal local application mode.
# DEPLOYMENT_ENV=preview
# BFF_PROXY_SECRET=at-least-32-server-only-characters
# CLEANUP_STALE_AFTER_SECONDS=10800
# ADMISSION_LEASE_SECONDS=120
# UPLOAD_RESERVATION_SECONDS=600
# LIVE_MEDIA_MAX_BYTES=1073741824
# AUTHENTICATED_API_PER_MINUTE_LIMIT=60
# UNAUTHENTICATED_API_PER_MINUTE_LIMIT=120

# Provisioned database identity, required when DEPLOYMENT_ENV is preview/production.
DEPLOYMENT_TARGET_ID=
