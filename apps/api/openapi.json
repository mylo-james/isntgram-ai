  "info": {
    "title": "Isntgram API",
    "description": "Isntgram API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": ["email", "username", "fullName", "password"]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": ["id", "email", "username", "fullName"]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": ["message", "user"]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "SignInResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "accessToken": {
            "type": "string"
          }
        },
        "required": ["message", "user", "accessToken"]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "DemoSignInResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "isDemoUser": {
            "type": "boolean"
          }
        },
        "required": ["message", "user", "isDemoUser"]
      },
      "MyProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "postCount": {
            "type": "number",
            "minimum": 0
          },
          "followerCount": {
            "type": "number",
            "minimum": 0
          },
          "followingCount": {
            "type": "number",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "username",
          "fullName",
          "postCount",
          "followerCount",
          "followingCount",
          "createdAt",
          "updatedAt",
          "email"
        ]
      },
      "UsernameAvailabilityDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        },
        "required": ["available"]
      },
      "PublicUserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
